# Production reference. Copy privately; replace placeholders; never commit .env.
# REQUIRED: dedicated RMR database, stable secrets and actual HTTPS hostname.
RMR_ENVIRONMENT=production
RMR_BASE_URL=https://rmr.example.com
RMR_HOST=0.0.0.0
RMR_PORT=8000
RMR_DATA_DIR=/data
RMR_DATABASE_URL=postgresql+psycopg://rmr:REPLACE_URL_ENCODED_PASSWORD@rmr-db:5432/rmr
RMR_SECRET_KEY=REPLACE_WITH_UNIQUE_RANDOM_SECRET
RMR_SETUP_TOKEN=REPLACE_WITH_ONE_TIME_RANDOM_TOKEN
RMR_CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_UNIQUE_RANDOM_ENCRYPTION_SECRET
# Generate a valid Fernet key; preserve securely with recovery material.
RMR_INTEGRATION_ENCRYPTION_KEY=REPLACE_WITH_VALID_FERNET_KEY
RMR_COOKIE_SECURE=true
RMR_SESSION_HOURS=12
RMR_LOCAL_RECOVERY_MODE=false
RMR_INSTALL_PROFILE=empty
RMR_AUTO_SEED=false
RMR_ALLOW_DEMO_CREDENTIALS=false
# Explicit migrate command must run before application startup.
RMR_AUTO_MIGRATE=false
RMR_MAX_UPLOAD_MB=250
RMR_INVITATION_HOURS=168
RMR_PASSWORD_RESET_MINUTES=30
# REQUIRED behind a proxy: set its actual trusted address/network.
FORWARDED_ALLOW_IPS=127.0.0.1

# OPTIONAL / EXPLICIT OPT-IN: live PIQ. OFF until credentials/budgets approved.
# Conservative reference bounds, NOT authorization to spend.
RMR_PIQ_LIVE_DISCOVERY_ENABLED=false
RMR_PIQ_DISCOVERY_PROVIDER=google_places
RMR_GOOGLE_PLACES_API_KEY=
RMR_PIQ_MAX_QUERIES_PER_RUN=1
RMR_PIQ_MAX_RESULTS_PER_RUN=50
RMR_PIQ_MAX_CANDIDATES_PER_RUN=100
RMR_PIQ_DISCOVERY_TIMEOUT_SECONDS=30
RMR_PIQ_LIVE_RESEARCH_ENABLED=false
RMR_PIQ_RESEARCH_PROVIDER=openai
RMR_PIQ_RESEARCH_WEB_SEARCH_ENABLED=false
RMR_PIQ_RESEARCH_MODEL=gpt-4.1-mini-2025-04-14
RMR_PIQ_RESEARCH_MAX_COST_USD=0.05
RMR_PIQ_RESEARCH_TIMEOUT_SECONDS=120
RMR_PIQ_JOB_MAX_ATTEMPTS=1
RMR_PIQ_WORKER_ENABLED=false
RMR_PIQ_WORKER_POLL_SECONDS=5
RMR_AI_API_KEY=
RMR_AI_BASE_URL=https://api.openai.com/v1
RMR_AI_MODEL=gpt-4.1-mini-2025-04-14

# REQUIRED for production invitations/password resets, separate from campaigns.
RMR_SYSTEM_EMAIL_PROVIDER=smtp
RMR_SYSTEM_EMAIL_FROM=no-reply@example.com
RMR_SYSTEM_SMTP_HOST=
RMR_SYSTEM_SMTP_PORT=587
RMR_SYSTEM_SMTP_STARTTLS=true
RMR_SYSTEM_SMTP_USERNAME=
RMR_SYSTEM_SMTP_PASSWORD=

# OPTIONAL: activate only after integration-specific acceptance.
# Standalone ProspectIQ federation: opt-in, read-only Phase 1 workspace.
RMR_PROSPECTIQ_BRIDGE_ENABLED=false
RMR_PROSPECTIQ_BASE_URL=
RMR_PROSPECTIQ_INTEGRATION_INSTANCE_ID=
RMR_PROSPECTIQ_AUTHORIZATION_CODE_TTL_SECONDS=60
RMR_PROSPECTIQ_ASSERTION_AUDIENCE=
RMR_PROSPECTIQ_ASSERTION_ISSUER=
RMR_PROSPECTIQ_CALLBACK_URL=
RMR_PROSPECTIQ_SIGNING_PRIVATE_KEY_FILE=
RMR_PROSPECTIQ_SIGNING_KEY_ID=
RMR_PROSPECTIQ_HMAC_KEY_ID=
RMR_PROSPECTIQ_HMAC_SECRET=
# Dedicated PIQ -> RMR CRM active verification keys, JSON object key-id: secret.
# Empty by default. Never reuse session/federation secrets. Overlap keys for rotation.
RMR_PROSPECTIQ_CRM_KEYS_JSON={}
# Provision dedicated signing/HMAC keys outside Git before explicit activation.
# Never reuse RMR_SECRET_KEY or a PIQ native session key.
RMR_CB1_WORKER_ENABLED=false
RMR_PROVIDER_MODE=mock
RMR_AI_MODE=safe-template
RMR_PAYMENT_PROVIDER=mock
RMR_MICROSOFT_CLIENT_ID=
RMR_MICROSOFT_CLIENT_SECRET=
RMR_MICROSOFT_TENANT=common
RMR_GOOGLE_CLIENT_ID=
RMR_GOOGLE_CLIENT_SECRET=
RMR_ALLOW_MANAGED_TENANT_EXCEPTION=false
RMR_EXTERNAL_SITE_LIVE_TEST=false

# DEMO/LOCAL ONLY: separate env and isolated DB; never production.
# RMR_ENVIRONMENT=development
# RMR_BASE_URL=http://localhost:8091
# RMR_COOKIE_SECURE=false
# RMR_DATABASE_URL=sqlite:////data/local-demo.db
# RMR_INSTALL_PROFILE=demo
# RMR_AUTO_MIGRATE=true
# RMR_AUTO_SEED=true
# RMR_ALLOW_DEMO_CREDENTIALS=true
# RMR_LOCAL_RECOVERY_MODE=true
# RMR_PIQ_DISCOVERY_PROVIDER=demonstration
# RMR_PIQ_RESEARCH_PROVIDER=demonstration
