# Copy outside Git. Native RMR_BASE_URL comes from .env.production and must match issuer.
RMR_PROSPECTIQ_BRIDGE_ENABLED=false
RMR_PROSPECTIQ_BASE_URL=https://<PIQ_HOSTNAME>
RMR_PROSPECTIQ_INTEGRATION_INSTANCE_ID=<STABLE_INSTANCE_ID>
RMR_PROSPECTIQ_ASSERTION_ISSUER=https://<RMR_HOSTNAME>
RMR_PROSPECTIQ_ASSERTION_AUDIENCE=<SHARED_AUDIENCE>
RMR_PROSPECTIQ_CALLBACK_URL=https://<PIQ_HOSTNAME>/
RMR_PROSPECTIQ_SIGNING_PRIVATE_KEY_FILE=/run/rmr-federation/signing.pem
RMR_PROSPECTIQ_SIGNING_KEY_ID=<RSA_KEY_ID>
RMR_PROSPECTIQ_HMAC_KEY_ID=<GRANT_KEY_ID>
RMR_PROSPECTIQ_HMAC_SECRET=<DEDICATED_GRANT_SECRET>
RMR_PROSPECTIQ_CRM_KEYS_JSON={"<CRM_KEY_ID>":"<SEPARATE_CRM_SECRET>"}
RMR_PROSPECTIQ_GRANT_MAX_SECONDS=28800
RMR_PROSPECTIQ_AUTHORIZATION_CODE_TTL_SECONDS=60
RMR_PROSPECTIQ_HMAC_KEYS_JSON={}
