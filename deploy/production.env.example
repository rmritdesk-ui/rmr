# REFERENCE ONLY. Copy to private .env.production on the VPS; chmod 600.
# Compose uses explicit environment entries, not the developer's populated .env.
# REQUIRED: update to the future commit that contains production Compose.
RMR_RELEASE_TAG=rmr-piq-integration-rc1-production
RMR_RELEASE_REVISION=REPLACE_WITH_DEPLOYED_COMMIT_SHA
RMR_BASE_URL=https://<RMR_HOSTNAME>
RMR_POSTGRES_DB=rmr
RMR_POSTGRES_USER=rmr
# Generate 32 random bytes as 64 hex characters. Do NOT use URL-reserved characters.
RMR_POSTGRES_PASSWORD=REPLACE_WITH_UNIQUE_64_HEX_PASSWORD
RMR_SECRET_KEY=REPLACE_WITH_UNIQUE_STABLE_RANDOM_SECRET
RMR_SETUP_TOKEN=REPLACE_WITH_ONE_TIME_SETUP_TOKEN
RMR_CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_UNIQUE_STABLE_ENCRYPTION_SECRET
RMR_INTEGRATION_ENCRYPTION_KEY=REPLACE_WITH_VALID_FERNET_KEY
# Start with loopback for bootstrap. Before app startup append the inspected RMR
# bridge gateway used by host Apache. Never trust '*' or unrelated networks.
FORWARDED_ALLOW_IPS=127.0.0.1

# Native embedded PIQ stays OFF for the standalone bridge rollout.
# Preserve approved provider values privately; enable only under separate live approval.
RMR_PIQ_WORKER_ENABLED=false
RMR_PIQ_LIVE_DISCOVERY_ENABLED=false
RMR_GOOGLE_PLACES_API_KEY=REPLACE_WITH_GOOGLE_PLACES_KEY
RMR_PIQ_LIVE_RESEARCH_ENABLED=false
RMR_PIQ_RESEARCH_WEB_SEARCH_ENABLED=false
RMR_AI_API_KEY=REPLACE_WITH_OPENAI_KEY
# Model/provider names, one attempt and production safety flags are set in Compose.
RMR_PIQ_MAX_QUERIES_PER_RUN=1
RMR_PIQ_MAX_RESULTS_PER_RUN=50
RMR_PIQ_MAX_CANDIDATES_PER_RUN=100
RMR_PIQ_RESEARCH_MAX_COST_USD=0.05

# REQUIRED for normal production invitations/password-reset delivery.
RMR_SYSTEM_EMAIL_FROM=no-reply@example.com
RMR_SYSTEM_SMTP_HOST=REPLACE_WITH_SMTP_HOST
RMR_SYSTEM_SMTP_PORT=587
RMR_SYSTEM_SMTP_USERNAME=REPLACE_WITH_SMTP_USERNAME
RMR_SYSTEM_SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
